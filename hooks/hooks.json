{
  "description": "Start the clipboard image paste terminal hotkey when Codex or Claude Code starts.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "cmd.exe /d /c \"\"${CLAUDE_PLUGIN_ROOT}/scripts/start-hotkey.cmd\"\"",
            "timeout": 30,
            "statusMessage": "Starting clipboard image paste hotkey"
          }
        ]
      }
    ]
  }
}
